# Copy to .env (never commit .env). Backend-only secrets: nothing here is NEXT_PUBLIC_*.
POSTGRES_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app
DATABASE_URL=postgresql://resonant_app:change-me-app@postgres:5432/resonant
DATABASE_OWNER_URL=postgresql://resonant:change-me-owner@postgres:5432/resonant
REDIS_URL=redis://redis:6379/0

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=resonant-minio
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET=resonant-private
S3_REGION=us-east-1
SIGNED_URL_TTL_S=900

MAX_UPLOAD_BYTES=52428800
MAX_DURATION_S=600
UPLOAD_RETENTION_HOURS=24
QUERY_MIN_S=5
QUERY_MAX_S=60

# Experimental windowing: "length:hop,length:hop" in seconds
WINDOWS=12:6,24:12
PREPROCESS_VERSION=pp1
CLAP_MODEL=laion/larger_clap_music
CLAP_REVISION=main
EMBED_DIM=512

# Experimental weights (embedding,harmonic,rhythm,timbre) per mode
WEIGHTS_BALANCED=0.45,0.30,0.15,0.10
WEIGHTS_VIBE=0.60,0.05,0.20,0.15
WEIGHTS_HARMONY=0.25,0.60,0.05,0.10

RATE_LIMIT_PER_MIN=60
UPLOAD_LIMIT_PER_HOUR=10
ANALYSIS_LIMIT_PER_HOUR=40

# Catalog adapters
ENABLE_MUSICBRAINZ=true
MUSICBRAINZ_USER_AGENT=Resonant/0.1 ( your-email@example.com )
ENABLE_JAMENDO=false
JAMENDO_CLIENT_ID=

CORS_ORIGIN=http://localhost:3000
